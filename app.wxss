page {
  --c-pass: #248A5A;
  --c-assist: #D88921;
  --c-blocked: #C84B4B;
  --c-unknown: #77838F;
  --brand: #1D3557;
  --brand-deep: #13233D;
  --brand-soft: #E9EEF5;
  --accent: #F16B4F;
  --ink: #17243A;
  --muted: #727887;
  --line: #E7E2DA;
  --surface: #FFFFFF;
  background: #F7F4EE;
  color: #17243A;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

button::after { border: none; }

/* 通用卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid #E7E2DA;
  border-radius: 22rpx;
  padding: 26rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(27, 61, 68, 0.05);
}

.muted {
  color: #727887;
  font-size: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.6;
}
.tag-pass { background: #248A5A; }
.tag-assist { background: #D88921; }
.tag-blocked { background: #C84B4B; }
.tag-unknown { background: #77838F; }

.btn {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  background: #1D3557;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(29, 53, 87, 0.16);
}
.btn-ghost {
  background: #ffffff;
  color: #1D3557;
  border: 1rpx solid #BBC6D5;
  box-shadow: none;
}
.btn-block {
  display: block;
  box-sizing: border-box;
  width: auto;
}

/* 四色结果大卡 */
.result-card { color: #ffffff; border-radius: 22rpx; padding: 30rpx; margin: 20rpx; box-shadow: 0 10rpx 24rpx rgba(27, 61, 68, 0.12); }
.result-pass { background: linear-gradient(135deg, #237A54, #36A36D); }
.result-assist { background: linear-gradient(135deg, #B96D16, #E19A36); }
.result-blocked { background: linear-gradient(135deg, #A63E45, #D45E5E); }
.result-unknown { background: linear-gradient(135deg, #5F6E79, #87949D); }

.divider {
  height: 1rpx;
  background: #E8EDEE;
  margin: 20rpx 0;
}
