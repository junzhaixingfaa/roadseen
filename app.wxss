page {
  --c-pass: #2BA245;
  --c-assist: #E6A23C;
  --c-blocked: #D93026;
  --c-unknown: #909399;
  --brand: #2f6fb0;
  background: #f5f6f8;
  color: #303133;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.muted {
  color: #909399;
  font-size: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.6;
}
.tag-pass { background: #2BA245; }
.tag-assist { background: #E6A23C; }
.tag-blocked { background: #D93026; }
.tag-unknown { background: #909399; }

.btn {
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  background: #2f6fb0;
  color: #ffffff;
}
.btn-ghost {
  background: #ffffff;
  color: #2f6fb0;
  border: 1rpx solid #2f6fb0;
}
.btn-block {
  display: block;
  box-sizing: border-box;
  width: auto;
}

/* 四色结果大卡 */
.result-card { color: #ffffff; border-radius: 16rpx; padding: 28rpx; margin: 20rpx; }
.result-pass { background: #2BA245; }
.result-assist { background: #E6A23C; }
.result-blocked { background: #D93026; }
.result-unknown { background: #909399; }

.divider {
  height: 1rpx;
  background: #ebeef5;
  margin: 20rpx 0;
}
