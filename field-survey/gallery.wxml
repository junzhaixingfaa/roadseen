<view class="page">
  <view class="title">实地无障碍调研</view>
  <view class="intro">实地采集日期：{{collectedAt}}。以下分析依据团队现场反馈与照片，反映采集当日情况；未测量项目保留待确认。</view>
  <view class="analysis-card">
    <view class="heading">通行结论</view>
    <view class="analysis-item" wx:for="{{summaries}}" wx:key="title">
      <view class="analysis-title">{{item.title}}</view>
      <view class="note">{{item.text}}</view>
    </view>
  </view>
  <view class="photo-title">现场照片与依据 · 点击查看大图</view>
  <view class="group" wx:for="{{groups}}" wx:key="title">
    <view class="heading">{{item.title}}</view>
    <view class="note">{{item.note}}</view>
    <image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="widthFix" lazy-load bindtap="preview" data-src="{{src}}" />
  </view>
</view>
