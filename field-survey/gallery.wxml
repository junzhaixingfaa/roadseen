<view class="page">
  <view class="title">实地无障碍调研</view>
  <view class="intro">实地采集日期：{{collectedAt}}。选择地点后查看对应大图、现场情况和通行建议。</view>
  <view class="site-card" wx:for="{{sites}}" wx:key="id" data-id="{{item.id}}" bindtap="openSite">
    <image class="site-cover" src="{{item.hero}}" mode="aspectFill" />
    <view class="site-copy">
      <view class="site-meta">{{item.category}}</view>
      <view class="heading">{{item.name}}</view>
      <view class="note">{{item.summary}}</view>
      <view class="more">查看现场照片与详情 ›</view>
    </view>
  </view>
</view>
