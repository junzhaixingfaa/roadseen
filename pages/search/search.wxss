.search-page { min-height: 100vh; background: #f5f6f8; }

.search-bar { padding: 20rpx; background: #ffffff; }
.ipt {
  background: #f0f2f5;
  border-radius: 30rpx;
  padding: 14rpx 26rpx;
  font-size: 28rpx;
}

.filters {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx 18rpx;
  background: #ffffff;
}
.chip {
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #606266;
  background: #f0f2f5;
}
.chip.on { background: #2f6fb0; color: #ffffff; }

.empty { text-align: center; color: #909399; padding: 80rpx 0; font-size: 26rpx; }

.result-item {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 16rpx 20rpx;
  padding: 22rpx;
}
.r-name { font-size: 32rpx; font-weight: 600; }
.r-sum { margin-top: 8rpx; font-size: 24rpx; color: #909399; }
