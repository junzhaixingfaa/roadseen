.search-page { min-height: 100vh; background: #F7F4EE; }

.search-bar { padding: 20rpx; background: #ffffff; }
.ipt {
  background: #f0f2f5;
  border-radius: 30rpx;
  padding: 14rpx 26rpx;
  font-size: 28rpx;
}

.filters {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx 18rpx;
  background: #ffffff;
}
.chip {
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #606266;
  background: #f0f2f5;
}
.chip.on { background: var(--brand); color: #ffffff; }

.empty { text-align: center; color: #909399; padding: 80rpx 0; font-size: 26rpx; }

.result-item {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 16rpx 20rpx;
  padding: 22rpx;
}
.r-name { font-size: 32rpx; font-weight: 600; }
.r-sum { margin-top: 8rpx; font-size: 24rpx; color: #909399; }

.search-page { background: #F7F4EE; padding-bottom: 30rpx; }
.search-bar { padding: 22rpx 20rpx 14rpx; background: #F7F4EE; }
.ipt { padding: 19rpx 24rpx; border: 1rpx solid #E7E2DA; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 6rpx 18rpx rgba(27,61,68,.05); }
.filters { padding: 8rpx 20rpx 16rpx; background: #F7F4EE; overflow-x: auto; }
.chip { flex: none; border-radius: 22rpx; color: #55666C; background: #E7E2DA; }
.chip.on { color: #fff; background: #1D3557; }
.result-meta { padding: 8rpx 24rpx; color: #727887; font-size: 23rpx; }
.result-item { margin: 14rpx 20rpx; padding: 26rpx; border: 1rpx solid #E7E2DA; border-radius: 22rpx; box-shadow: 0 8rpx 22rpx rgba(27,61,68,.05); }
.r-name { color: #17243A; }
.r-sum { color: #727887; }
