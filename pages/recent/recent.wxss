.recent-page { min-height: 100vh; padding: 20rpx 0 50rpx; background: #F7F4EE; }
.recent-head { margin: 0 20rpx 18rpx; padding: 26rpx 28rpx; border-radius: 22rpx; color: #FFFFFF; background: #13233D; }
.head-title { font-size: 33rpx; font-weight: 700; }
.head-copy { margin-top: 7rpx; color: #D4DCE8; font-size: 22rpx; }
.recent-card { margin: 0 20rpx 14rpx; padding: 25rpx; border: 1rpx solid #E7E2DA; border-radius: 21rpx; background: #FFFFFF; }
.recent-card:active { background: #FCFAF6; }
.place-name { color: #17243A; font-size: 30rpx; font-weight: 700; }
.place-meta { margin-top: 6rpx; color: #819096; font-size: 21rpx; }
.summary { margin-top: 16rpx; color: #53646B; font-size: 23rpx; line-height: 1.5; }
.empty { padding: 130rpx 60rpx; text-align: center; }
.empty-icon { width: 90rpx; height: 90rpx; margin: 0 auto 24rpx; border-radius: 50%; color: #1D3557; background: #F6DAD0; font-size: 42rpx; line-height: 90rpx; }
.empty-title { color: #17243A; font-size: 32rpx; font-weight: 700; }
.empty-desc { margin: 18rpx 0 40rpx; color: #727887; font-size: 25rpx; line-height: 1.65; }
