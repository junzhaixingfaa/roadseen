.ps { min-height: 100vh; background: #f5f6f8; padding: 20rpx 0; }
.intro {
  margin: 8rpx 24rpx 4rpx;
  background: #eaf1f9;
  color: #2f6fb0;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
}
.field { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.field:last-child { border-bottom: none; }
.lab { font-size: 28rpx; color: #303133; }
.pk { color: #2f6fb0; font-size: 28rpx; }
.ipt { text-align: right; font-size: 28rpx; width: 260rpx; }
.save { margin: 32rpx 24rpx; }
.link { text-align: center; color: #909399; font-size: 26rpx; padding: 24rpx; }
