.survey { min-height: 100vh; background: #f5f6f8; padding-bottom: 40rpx; }

.contrib {
  display: flex;
  align-items: center; background: #ffffff; border-radius: 16rpx;
  margin: 20rpx; padding: 28rpx 0;
}
.c-item { flex: 1; text-align: center; }
.c-num { display: block; font-size: 36rpx; font-weight: 700; color: #2f6fb0; }
.c-lab { display: block; font-size: 22rpx; color: #909399; margin-top: 6rpx; }

.btn-block { margin: 24rpx; }
.section-title { margin: 24rpx 0 8rpx; }

.empty { text-align: center; color: #909399; padding: 50rpx 0; font-size: 26rpx; }
.task { background: #ffffff; border-radius: 14rpx; margin: 16rpx 20rpx; padding: 22rpx; }
.t-name { font-size: 30rpx; font-weight: 600; }
.t-reason { font-size: 22rpx; color: #E6A23C; background: #fdf6e3; padding: 2rpx 12rpx; border-radius: 10rpx; }
.t-cat { font-size: 24rpx; color: #909399; margin-top: 8rpx; }

.survey { background: #F3F6F6; }
.survey-head { margin: 18rpx 20rpx 0; padding: 30rpx 28rpx; border-radius: 26rpx; color: #FFFFFF; background: #103F4A; }
.survey-kicker { color: #9ECBC5; font-size: 18rpx; letter-spacing: 4rpx; }
.survey-title { margin-top: 10rpx; font-size: 34rpx; font-weight: 700; }
.survey-copy { margin-top: 8rpx; color: #D5E7E4; font-size: 23rpx; }
.contrib { margin: 14rpx 20rpx; padding: 24rpx 0; border: 1rpx solid #E1E8E8; border-radius: 22rpx; box-shadow: 0 8rpx 22rpx rgba(27,61,68,.05); }
.c-item { border-right: 1rpx solid #E7ECEC; }
.c-item:last-child { border-right: none; }
.c-num { color: #176B70; font-size: 34rpx; }
.c-lab { color: #718089; }
.survey > .btn-block { margin: 20rpx; border-radius: 18rpx; }
.task { position: relative; margin: 14rpx 20rpx; padding: 26rpx; border: 1rpx solid #E1E8E8; border-radius: 22rpx; box-shadow: 0 8rpx 22rpx rgba(27,61,68,.04); }
.task::before { content: ''; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: 6rpx; border-radius: 0 6rpx 6rpx 0; background: #D88921; }
.t-name { color: #1D2B32; }
.t-reason { color: #9B631C; background: #FFF3DF; }
.t-cat { color: #718089; }
.quick-check-card { display: flex; align-items: center; gap: 16rpx; margin: 14rpx 20rpx; padding: 24rpx; border: 1rpx solid #CFE1DF; border-radius: 22rpx; background: linear-gradient(105deg, #EAF6F4, #FFFFFF); }
.qc-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; color: #fff; background: #176B70; font-size: 22rpx; font-weight: 800; }
.qc-copy { flex: 1; }
.qc-title { color: #18383D; font-size: 27rpx; font-weight: 700; }
.qc-sub { margin-top: 5rpx; color: #728489; font-size: 21rpx; }
.qc-arrow { color: #176B70; font-size: 42rpx; }
.visitor-note { margin: 16rpx 20rpx; padding: 24rpx; border: 1rpx solid #E1E8E8; border-radius: 20rpx; color: #718187; background: #FFFFFF; font-size: 23rpx; line-height: 1.6; }
.visitor-title { margin-bottom: 6rpx; color: #253A40; font-size: 27rpx; font-weight: 700; }
