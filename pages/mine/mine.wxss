.mine { min-height: 100vh; background: #f5f6f8; padding-bottom: 40rpx; }

.profile-hd { display: flex; align-items: center; padding: 40rpx 30rpx; background: #ffffff; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--brand); color: #ffffff; font-size: 44rpx;
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
}
.p-name { font-size: 32rpx; font-weight: 600; }
.p-role { font-size: 24rpx; color: #909399; margin-top: 6rpx; }
.p-account { margin-top: 3rpx; color: var(--brand); font-size: 22rpx; }

.card { background: #ffffff; border-radius: 16rpx; margin: 20rpx; padding: 8rpx 24rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; font-size: 28rpx; }
.val { color: var(--brand); font-size: 26rpx; }
.val.muted { color: #b8bcc4; }

.list .li { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #f2f3f5; font-size: 28rpx; }
.list .li:last-child { border-bottom: none; }

.privacy-note, .prototype-note { margin: 20rpx; padding: 20rpx 24rpx; border-radius: 14rpx; font-size: 23rpx; line-height: 1.55; }
.privacy-note { color: #35627e; background: #eaf4f8; }
.prototype-note { color: #8c7a5b; background: #f7f3eb; }
.logout { margin: 28rpx 20rpx 0; padding: 20rpx; border: 1rpx solid #d7dde3; border-radius: 12rpx; color: #606266; background: #fff; text-align: center; font-size: 27rpx; }

.mine { background: #F3F6F6; }
.profile-hd { margin: 18rpx 20rpx 0; padding: 34rpx 28rpx; border-radius: 28rpx; color: #FFFFFF; background: #103F4A; box-shadow: 0 14rpx 34rpx rgba(16,63,74,.15); }
.avatar { width: 92rpx; height: 92rpx; border-radius: 24rpx; color: #103F4A; background: #D9EEEA; font-size: 38rpx; font-weight: 800; }
.p-name { font-size: 34rpx; }
.p-role { display: inline-block; margin-top: 8rpx; padding: 2rpx 12rpx; border-radius: 16rpx; color: #D9EEEA; background: rgba(255,255,255,.1); font-size: 21rpx; }
.p-account { color: #A9D1CC; }
.mine .card { margin: 14rpx 20rpx; border: 1rpx solid #E1E8E8; border-radius: 22rpx; box-shadow: 0 8rpx 22rpx rgba(27,61,68,.04); }
.mine .row-between { color: #26373E; }
.val { color: #176B70; font-weight: 600; }
.list .li { border-color: #E8EDED; }
.privacy-note { color: #315F61; background: #E7F2F2; border: 1rpx solid #D3E7E4; }
.prototype-note { color: #786D5B; background: #F7F3EA; }
.logout { border-radius: 16rpx; color: #A54545; border-color: #E9CFCF; background: #FFF9F9; }
