.mine { min-height: 100vh; background: #f5f6f8; padding-bottom: 40rpx; }

.profile-hd { display: flex; align-items: center; padding: 40rpx 30rpx; background: #ffffff; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #2f6fb0; color: #ffffff; font-size: 44rpx;
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
}
.p-name { font-size: 32rpx; font-weight: 600; }
.p-role { font-size: 24rpx; color: #909399; margin-top: 6rpx; }

.card { background: #ffffff; border-radius: 16rpx; margin: 20rpx; padding: 8rpx 24rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; font-size: 28rpx; }
.val { color: #2f6fb0; font-size: 26rpx; }
.val.muted { color: #b8bcc4; }

.list .li { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #f2f3f5; font-size: 28rpx; }
.list .li:last-child { border-bottom: none; }

.switch-card { background: #ffffff; border-radius: 16rpx; margin: 20rpx; padding: 20rpx 24rpx; }
.sc-title { font-size: 24rpx; padding-bottom: 8rpx; }
.u-item { padding: 20rpx 0; border-bottom: 1rpx solid #f2f3f5; font-size: 26rpx; }
.u-item:last-child { border-bottom: none; }
.u-item.on { color: #2f6fb0; font-weight: 600; }
