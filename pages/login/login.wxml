<view class="login-page">
  <view class="login-hero">
    <view class="brand-row"><view class="logo-mark">路</view><view class="brand">路见</view></view>
    <view class="eyebrow">ACCESSIBLE CAMPUS</view>
    <view class="slogan">每一次出发，都应该心里有数</view>
    <view class="hero-copy">校园无障碍通行信息 · 现场证据 · 个性化判断</view>
  </view>

  <view class="session-card" wx:if="{{currentUser}}">
    <view>
      <view class="session-title">欢迎回来，{{currentUser.nickname}}</view>
      <view class="session-account">已登录账号：{{currentUser.account}}</view>
    </view>
    <view class="session-actions">
      <button class="primary-small" bindtap="continueSession">继续使用</button>
      <button class="text-small" bindtap="changeAccount">换个账号</button>
    </view>
  </view>

  <view class="login-card" wx:else>
    <view class="mode-tabs">
      <view class="mode {{mode === 'login' ? 'on' : ''}}" data-mode="login" bindtap="switchMode">账号登录</view>
      <view class="mode {{mode === 'register' ? 'on' : ''}}" data-mode="register" bindtap="switchMode">注册账号</view>
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">昵称</text>
      <input class="input" value="{{nickname}}" maxlength="20" placeholder="怎么称呼你" bindinput="onNickname" />
    </view>
    <view class="field">
      <text class="label">账号</text>
      <input class="input" value="{{account}}" maxlength="24" placeholder="请输入账号" bindinput="onAccount" />
    </view>
    <view class="field">
      <view class="row-between"><text class="label">密码</text><text class="show-pass" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text></view>
      <input class="input" password="{{!showPassword}}" value="{{password}}" maxlength="32" placeholder="至少6个字符" bindinput="onPassword" />
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="submit" bindtap="submit" loading="{{busy}}">{{mode === 'login' ? '登录并进入' : '注册并设置通行情况'}}</button>

    <view class="demo-box" wx:if="{{mode === 'login'}}">
      <view class="demo-title">快速体验</view>
      <view class="demo-copy">普通用户：demo / 123456　管理员：admin / admin123</view>
      <view class="demo-actions">
        <text data-role="user" bindtap="fillDemo">填入普通用户</text>
        <text data-role="admin" bindtap="fillDemo">填入管理员</text>
      </view>
    </view>
    <view class="safe-tip">当前为本地原型，请勿使用真实密码。正式版本将接入微信云开发安全认证。</view>
  </view>

  <view class="feature-row">
    <view class="feature"><text class="feature-icon">◉</text><text>查看地点</text></view>
    <view class="feature"><text class="feature-icon">✓</text><text>判断通行</text></view>
    <view class="feature"><text class="feature-icon">⌁</text><text>共建信息</text></view>
  </view>
</view>
