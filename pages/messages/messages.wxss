.msg { min-height: 100vh; background: #F7F4EE; padding: 20rpx 0 40rpx; }
.msg .card { margin: 0 24rpx 20rpx; }
.mitem:active { background: #f0f2f5; }
.mtype { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; color: #fff; }
.mtype-incident { background: #D93026; }
.mtype-recover { background: #2BA245; }
.mtype-system { background: var(--brand); }
.mtime { font-size: 24rpx; }
.mtitle { margin-top: 14rpx; font-size: 32rpx; color: #303133; font-weight: 600; }
.mdesc { margin-top: 8rpx; font-size: 27rpx; color: #606266; line-height: 1.5; }
.empty { text-align: center; padding: 100rpx 60rpx; }
.empty .btn { margin-top: 40rpx; }

.msg { background: #F7F4EE; }
.msg-head { margin: 0 20rpx 22rpx; padding: 28rpx; border-radius: 24rpx; color: #FFFFFF; background: #13233D; }
.msg-title { font-size: 34rpx; font-weight: 700; }
.read-all { color: #F6DAD0; font-size: 20rpx; }
.msg-copy { margin-top: 8rpx; color: #D4DCE8; font-size: 23rpx; }
.msg-stats { display: flex; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.14); }
.msg-stats view { flex: 1; display: flex; flex-direction: column; gap: 5rpx; color: #D4DCE8; font-size: 20rpx; }
.msg-stats view text:first-child { color: #FFFFFF; font-size: 34rpx; font-weight: 700; }
.filter-row { display: flex; gap: 12rpx; margin: -8rpx 20rpx 18rpx; }
.filter-chip { padding: 12rpx 24rpx; border: 1rpx solid #D8E3E2; border-radius: 28rpx; color: #617078; background: #FFFFFF; font-size: 23rpx; }
.filter-chip.on { color: #FFFFFF; border-color: #1D3557; background: #1D3557; }
.msg .card { margin: 0 20rpx 14rpx; padding: 26rpx; }
.mitem { border-left: 6rpx solid #D5E2E2; }
.mitem.unread { border-left-color: #1D3557; box-shadow: 0 8rpx 22rpx rgba(23,107,112,.09); }
.type-wrap { display: flex; align-items: center; gap: 10rpx; }
.unread-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #E05B4B; }
.mitem:active { background: #FCFAF6; }
.mtype { padding: 5rpx 14rpx; font-size: 20rpx; font-weight: 600; }
.mtype-incident { background: #C84B4B; }
.mtype-recover { background: #248A5A; }
.mtype-review { background: #D88921; }
.mtype-system { background: #1D3557; }
.mtitle { color: #17243A; font-size: 30rpx; }
.mdesc { color: #617078; font-size: 25rpx; }
.relation { display: inline-block; margin-top: 14rpx; padding: 4rpx 12rpx; border-radius: 14rpx; color: #1D3557; background: #E9EEF5; font-size: 20rpx; }
