<view class="admin">
  <view wx:if="{{!isAdmin}}" class="denied">
    <view class="denied-title">无管理权限</view>
    <view class="muted">当前账号不是管理员。请在「我的」切换到管理员测试账号后重试。</view>
    <button class="btn btn-block" bindtap="goMine">去我的</button>
  </view>

  <block wx:else>
    <view class="dashboard">
      <view class="dashboard-head"><view><view class="dashboard-title">运营概览</view><view class="dashboard-copy">需要处理的事项集中显示</view></view><view class="live-dot">实时</view></view>
      <view class="dashboard-grid">
        <view class="metric" data-key="inspection" bindtap="switchTab"><text>{{dashboard.pendingInspection}}</text><text>待审勘察</text></view>
        <view class="metric" data-key="incident" bindtap="switchTab"><text>{{dashboard.activeIncident}}</text><text>进行事件</text></view>
        <view class="metric" data-key="review" bindtap="switchTab"><text>{{dashboard.pendingReview}}</text><text>待复核</text></view>
        <view class="metric" data-key="place" bindtap="switchTab"><text>{{dashboard.incompletePlace}}</text><text>资料不足</text></view>
      </view>
    </view>
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </view>

    <!-- 勘察审核 -->
    <view wx:if="{{tab === 'inspection'}}" class="body">
      <view wx:if="{{!inspections.length}}" class="empty muted">暂无待审核的勘察提交。</view>
      <view wx:for="{{inspections}}" wx:key="id" class="card item">
        <view class="row-between">
          <text class="it-name">{{item.placeName}}</text>
          <text class="pill pill-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="muted it-sub">{{item.itemCount}} 个环节 · 提交人 {{item.submittedBy}} · {{item.timeText}}</view>
        <view class="review-note" wx:if="{{item.reviewNote}}">审核记录：{{item.reviewNote}}</view>
        <scroll-view scroll-x="{{true}}" class="inspection-scroll" wx:if="{{item.items.length}}">
          <view class="inspection-fields">
            <view class="inspection-field" wx:for="{{item.items}}" wx:for-item="field" wx:key="key">
              <image class="inspection-photo" wx:if="{{field.photo}}" src="{{field.photo}}" mode="aspectFill" />
              <view class="field-title">{{field.title}} · {{field.choiceText}}</view>
              <view class="muted field-line">{{field.detectedText}}</view>
              <view class="muted field-line" wx:if="{{field.detailText}}">{{field.detailText}}</view>
              <view class="ocr" wx:if="{{field.ocrText}}">OCR：{{field.ocrText}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{item.status === 'pending'}}" class="it-acts">
          <button class="mini mini-ok" data-id="{{item.id}}" bindtap="approve">通过并发布</button>
          <button class="mini mini-no" data-id="{{item.id}}" bindtap="reject">驳回</button>
        </view>
      </view>
    </view>

    <!-- 事件管理 -->
    <view wx:elif="{{tab === 'incident'}}" class="body">
      <view wx:for="{{incidents}}" wx:key="id" class="card item">
        <view class="row-between">
          <text class="it-name">{{item.facilityText}}{{item.type ? ' · ' + item.type : ''}}</text>
          <text class="pill {{item.status === 'active' ? 'st-active' : (item.status === 'resolved' ? 'st-done' : 'st-pending')}}">{{item.statusText}}</text>
        </view>
        <view class="muted it-sub">{{item.description}}{{item.expectedEndAt ? '（预计 ' + item.expectedEndAt + '）' : ''}}</view>
        <view wx:if="{{item.isTestData}}" class="test-flag">演示数据</view>
        <view wx:if="{{item.status === 'active'}}" class="it-acts">
          <button class="mini mini-ok" data-id="{{item.id}}" bindtap="resolveIncident">标记已恢复</button>
        </view>
        <view wx:elif="{{item.status === 'pending_review'}}" class="it-acts">
          <button class="mini mini-ok" data-id="{{item.id}}" bindtap="resolveIncident">确认已恢复</button>
          <button class="mini mini-no" data-id="{{item.id}}" bindtap="reactivateIncident">仍在进行中</button>
        </view>
      </view>
    </view>

    <!-- 纠错复核 -->
    <view wx:elif="{{tab === 'review'}}" class="body">
      <view wx:if="{{!reviews.length}}" class="empty muted">暂无用户纠错或复核记录。</view>
      <view wx:for="{{reviews}}" wx:key="id" class="card item">
        <view class="row-between">
          <text class="it-name">{{item.placeName}}</text>
          <text class="pill {{item.status === 'pending' ? 'pill-pending' : 'st-done'}}">{{item.statusText}}</text>
        </view>
        <view class="review-kind">用户反馈：{{item.kindText}}</view>
        <view class="muted it-sub">提交人 {{item.submittedBy}} · {{item.timeText}}</view>
        <view class="review-note" wx:if="{{item.reviewNote}}">处理记录：{{item.reviewNote}}</view>
        <view wx:if="{{item.status === 'pending'}}" class="it-acts">
          <button class="mini mini-ok" data-id="{{item.id}}" bindtap="reviewFeedback">处理反馈</button>
        </view>
      </view>
    </view>

    <!-- 地点状态 -->
    <view wx:elif="{{tab === 'place'}}" class="body">
      <view wx:for="{{places}}" wx:key="id" class="card item" data-id="{{item.id}}" bindtap="openPlace">
        <view class="row-between">
          <text class="it-name">{{item.name}}</text>
          <text class="tag tag-{{item.resultCls}}">{{item.resultText}}</text>
        </view>
        <view class="muted it-sub">入口 {{item.entrance}} 个{{item.pending ? ' · 待勘察' : ''}}</view>
      </view>
    </view>

    <!-- AI 日志 -->
    <view wx:else class="body">
      <view wx:if="{{!aiLogs.length}}" class="empty muted">本会话还没有 AI 调用记录。到「勘察」走一遍拍摄与识别即可生成。</view>
      <view wx:for="{{aiLogs}}" wx:key="index" class="card log">
        <view class="row-between">
          <text class="it-name">{{item.stepKey}}</text>
          <text class="pill {{item.ok ? 'st-done' : 'st-active'}}">{{item.ok ? '成功' : '失败'}}</text>
        </view>
        <view class="muted it-sub">{{item.msg}} · {{item.timeText}}</view>
      </view>
    </view>
  </block>
</view>
