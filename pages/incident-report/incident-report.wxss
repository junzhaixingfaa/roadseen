.form { min-height: 100vh; background: #F7F4EE; padding: 20rpx 0 180rpx; }
.form .card { margin: 0 24rpx 20rpx; }
.picker-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.picker-row:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #303133; }
.value { font-size: 28rpx; color: var(--brand); flex: 1; text-align: right; margin-right: 12rpx; }
.arrow { color: #c0c4cc; font-size: 34rpx; }
.desc { width: 100%; box-sizing: border-box; min-height: 140rpx; font-size: 28rpx; padding: 12rpx 0; }
.photo-box { padding: 8rpx 0; }
.photo { width: 260rpx; height: 200rpx; border-radius: 12rpx; }
.photo-empty { width: 260rpx; height: 200rpx; border: 2rpx dashed #c8ccd4; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #909399; font-size: 26rpx; }
.btn-block { margin: 8rpx 24rpx 0; }
.tip { text-align: center; padding: 24rpx 40rpx; font-size: 24rpx; }

.form { background: #F7F4EE; }
.form-head { margin: 0 20rpx 18rpx; padding: 30rpx 28rpx; border-radius: 26rpx; color: #FFFFFF; background: #13233D; }
.form-kicker { color: #F8C9B9; font-size: 18rpx; letter-spacing: 4rpx; }
.form-title { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; }
.form-copy { margin-top: 8rpx; color: #D4DCE8; font-size: 23rpx; }
.form .card { margin: 0 20rpx 14rpx; padding: 24rpx 26rpx; }
.picker-row { border-color: #E7E2DA; }
.label { color: #283940; }
.value { color: #1D3557; font-weight: 600; }
.desc { margin-top: 8rpx; padding: 18rpx; border: 1rpx solid #E7E2DA; border-radius: 16rpx; background: #FCFAF6; }
.photo, .photo-empty { width: 100%; height: 230rpx; border-radius: 18rpx; }
.photo-empty { border-color: #ADBBD0; color: #1D3557; background: #F4F0E8; }
.form > .btn-block { margin: 22rpx 20rpx 0; background: #C74B32; border-radius: 12rpx; }

.place-input-row { display:flex; align-items:center; gap:14rpx; margin-top:16rpx; padding:18rpx 20rpx; border:1rpx solid #E1DBD1; border-radius:14rpx; background:#FCFAF6; }
.place-pin { flex:none; color:#1D3557; font-size:30rpx; font-weight:700; }
.place-input { flex:1; min-width:0; height:48rpx; color:#1D3557; font-size:27rpx; }
.place-help { margin-top:12rpx; color:#858A94; font-size:21rpx; }
.quick-places { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:18rpx; }
.quick-place { display:flex; align-items:center; gap:8rpx; padding:12rpx 16rpx; border:1rpx solid #DED8CE; border-radius:12rpx; color:#405063; background:#F6F2EA; font-size:22rpx; }
.quick-place.active { color:#FFFFFF; border-color:#1D3557; background:#1D3557; }
.quick-category { opacity:.68; font-size:19rpx; }
