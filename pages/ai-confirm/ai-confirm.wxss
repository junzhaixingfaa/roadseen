.aic { min-height: 100vh; background: #f5f6f8; padding-bottom: 140rpx; }

.aic-hd { background: #ffffff; padding: 24rpx; }
.aic-title { font-size: 32rpx; font-weight: 600; }
.aic-tools { margin-top: 12rpx; }
.tool { font-size: 24rpx; color: #2f6fb0; background: #eaf1f9; padding: 6rpx 18rpx; border-radius: 20rpx; }

.item { background: #ffffff; border-radius: 14rpx; margin: 16rpx 20rpx; padding: 22rpx; }
.it-title { font-size: 28rpx; font-weight: 600; }
.it-conf { font-size: 22rpx; color: #909399; }
.it-photo { width: 100%; height: 240rpx; border-radius: 12rpx; margin: 12rpx 0; background: #ebeef5; }
.it-loading { padding: 16rpx 0; }
.it-error { color: #D93026; font-size: 24rpx; background: #fdeceb; border-radius: 10rpx; padding: 16rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 8rpx 0; }
.chip { font-size: 22rpx; color: #2f6fb0; background: #eaf1f9; padding: 4rpx 16rpx; border-radius: 16rpx; }
.it-basis { margin: 6rpx 0; }

.ef { display: flex; align-items: center; padding: 12rpx 0; border-top: 1rpx solid #f2f3f5; }
.ef-lab { width: 150rpx; color: #909399; font-size: 24rpx; }
.ef-ipt { flex: 1; font-size: 26rpx; }

.it-unknown { font-size: 22rpx; color: #a06a10; margin-top: 8rpx; }
.it-retake { font-size: 22rpx; color: #909399; margin-top: 4rpx; }

.choice { display: flex; gap: 16rpx; margin-top: 16rpx; }
.c-btn { flex: 1; text-align: center; font-size: 24rpx; color: #606266; background: #f0f2f5; border-radius: 24rpx; padding: 12rpx 0; }
.c-btn.on { background: #2f6fb0; color: #ffffff; }

.aic-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #ffffff; border-top: 1rpx solid #eee; padding: 16rpx 24rpx;
  z-index: 10;
}
.aic-bar .btn-block { margin: 0; }
.btn.disabled { opacity: 0.55; }

.aic { background: #F3F6F6; }
.aic-hd { margin: 18rpx 20rpx 0; padding: 28rpx; border-radius: 26rpx; color: #FFFFFF; background: #103F4A; }
.aic-title { font-size: 34rpx; font-weight: 700; }
.aic-hd .muted { color: #D5E7E4; }
.tool { color: #103F4A; background: #D9EEEA; }
.item { margin: 14rpx 20rpx; padding: 26rpx; border: 1rpx solid #E1E8E8; border-radius: 22rpx; box-shadow: 0 8rpx 22rpx rgba(27,61,68,.04); }
.it-title { color: #1D2B32; }
.it-photo { border-radius: 18rpx; }
.chip { color: #176B70; background: #E7F2F2; }
.ef { border-color: #E7ECEC; }
.ef-lab { color: #718089; }
.ef-ipt { color: #27383F; }
.choice { padding: 6rpx; border-radius: 28rpx; background: #EEF2F2; }
.c-btn { background: transparent; }
.c-btn.on { background: #176B70; box-shadow: 0 5rpx 12rpx rgba(23,107,112,.18); }
.aic-bar { padding: 16rpx 20rpx 24rpx; border-color: #E1E8E8; box-shadow: 0 -8rpx 24rpx rgba(27,61,68,.07); }
