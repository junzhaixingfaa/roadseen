<view class="aic">
  <view class="aic-hd">
    <view class="aic-title">AI 识别结果 · 人工确认</view>
    <view class="muted">{{placeName ? ('地点：' + placeName) : '未指定地点'}} · AI 仅预填，需你逐项确认</view>
    <view class="aic-tools">
      <text class="tool" bindtap="simulateFail" wx:if="{{!aiFailed}}">模拟识别失败</text>
      <text class="tool" bindtap="retryAi" wx:else>重新识别</text>
    </view>
  </view>

  <view class="item" wx:for="{{items}}" wx:key="key">
    <view class="row-between">
      <text class="it-title">{{item.title}}</text>
      <text class="it-conf" wx:if="{{item.confidence}}">置信 {{item.confidence}}</text>
    </view>
    <image class="it-photo" wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" />

    <view class="muted it-loading" wx:if="{{item.loading}}">AI 识别中…</view>

    <view class="it-error" wx:elif="{{item.error}}">
      {{item.error}}
      <view class="muted" style="margin-top:6rpx;">可继续人工填写下方字段后提交</view>
    </view>

    <view wx:else>
      <view class="chips" wx:if="{{item.detected.length}}">
        <text class="chip" wx:for="{{item.detected}}" wx:for-item="d" wx:key="*this">{{d}}</text>
      </view>
      <view class="muted it-basis" wx:if="{{item.basis}}">依据：{{item.basis}}</view>

      <view class="ef" wx:if="{{item.stepCount !== '' || item.key === 'step'}}">
        <text class="ef-lab">台阶数</text>
        <input class="ef-ipt" type="digit" value="{{item.stepCount}}" data-i="{{index}}" data-f="stepCount" bindinput="editField" placeholder="AI 未判断可手填" />
      </view>
      <view class="ef" wx:if="{{item.doorType || item.key === 'entrance'}}">
        <text class="ef-lab">门类型</text>
        <input class="ef-ipt" value="{{item.doorType}}" data-i="{{index}}" data-f="doorType" bindinput="editField" placeholder="自动门/平开门…" />
      </view>
      <view class="ef" wx:if="{{item.elevatorStatus || item.key === 'elevator'}}">
        <text class="ef-lab">电梯状态</text>
        <input class="ef-ipt" value="{{item.elevatorStatus}}" data-i="{{index}}" data-f="elevatorStatus" bindinput="editField" placeholder="normal/fault/未知" />
      </view>
      <view class="ef">
        <text class="ef-lab">OCR 文字</text>
        <input class="ef-ipt" value="{{item.ocrText}}" data-i="{{index}}" bindinput="editOcr" placeholder="通知/开放时间" />
      </view>

      <view class="it-unknown" wx:if="{{item.unknownFields.length}}">无法判断：{{item.unknownFields}}</view>
      <view class="it-retake" wx:if="{{item.suggestRetake.length}}">建议补拍：{{item.suggestRetake}}</view>

      <view class="choice">
        <text class="c-btn {{item.choice === 'confirmed' ? 'on' : ''}}" data-i="{{index}}" data-v="confirmed" bindtap="choose">确认</text>
        <text class="c-btn {{item.choice === 'modified' ? 'on' : ''}}" data-i="{{index}}" data-v="modified" bindtap="choose">已修改</text>
        <text class="c-btn {{item.choice === 'unknown' ? 'on' : ''}}" data-i="{{index}}" data-v="unknown" bindtap="choose">标记未知</text>
      </view>
    </view>
  </view>

  <view style="height: 140rpx;"></view>
  <view class="aic-bar">
    <view class="btn btn-block" bindtap="submit">确认无误，提交审核</view>
  </view>
</view>
