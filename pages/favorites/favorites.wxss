.fav { min-height: 100vh; background: #f5f6f8; padding: 20rpx 0 40rpx; }
.fav .card { margin: 0 24rpx 20rpx; }
.name { font-size: 32rpx; color: #303133; font-weight: 600; }
.addr { margin-top: 10rpx; font-size: 26rpx; }
.place:active { background: #f0f2f5; }
.empty { padding: 120rpx 60rpx; text-align: center; }
.empty-title { font-size: 32rpx; color: #303133; font-weight: 600; }
.empty-desc { margin: 20rpx 0 40rpx; font-size: 26rpx; color: #909399; line-height: 1.6; }
