<view class="fav">
  <view wx:if="{{empty}}" class="empty">
    <view class="empty-title">还没有收藏的地点</view>
    <view class="empty-desc">在地点通行卡右上角点「收藏」，常去地点会出现在这里。</view>
    <button class="btn btn-block" bindtap="goMap">去地图看看</button>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="card place" data-id="{{item.id}}" bindtap="open">
    <view class="row-between">
      <text class="name">{{item.name}}</text>
      <text class="tag tag-{{item.resultCls}}">{{item.resultText}}</text>
    </view>
    <view class="muted addr">{{item.summary || item.address}}</view>
  </view>
</view>
