<view class="map-page">
  <view class="page-head">
    <view><view class="page-title">路见·无障碍通行</view><view class="page-sub">实地信息，让每一次出门更有把握</view></view>
    <view class="report-link" bindtap="reportIncident">上报障碍</view>
  </view>

  <view class="ai-hero" bindtap="goQuickCheck">
    <view class="ai-mark">AI</view>
    <view class="ai-copy">
      <view class="ai-title">拍照识别通行障碍</view>
      <view class="ai-desc">对准入口、坡道或电梯拍一张，快速获得通行分析和建议</view>
      <view class="ai-action">立即拍照识别 <text>›</text></view>
    </view>
    <view class="camera-shape"><view class="camera-lens"></view></view>
  </view>

  <view class="section-head">
    <view class="section-title-main">地图</view>
  </view>

  <view class="survey-map">
    <view class="map-caption">模拟示意图 · 不用于导航</view>
    <view class="road-horizontal">富丰路 / 科兴路</view>
    <view class="road-vertical">西四环南路</view>
    <view class="survey-pin pin-xinghuo" data-id="xinghuo" bindtap="openPlace"><text>●</text>星火科技大厦</view>
    <view class="survey-pin pin-metro" data-id="metro" bindtap="openPlace"><text>●</text>富丰桥地铁站</view>
    <view class="survey-pin pin-rtmart" data-id="rtmart" bindtap="openPlace"><text>●</text>大润发（科兴店）</view>
    <view class="map-caption map-bottom">点击点位查看现场照片和情况</view>
  </view>

  <view class="place-list" id="placeList">
    <view class="place-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="pickFromList">
      <image class="place-thumb" src="{{item.hero}}" mode="aspectFill" />
      <view class="place-copy">
        <view class="place-topline"><view class="place-name">{{item.name}}</view><status-tag code="{{item.result}}" /></view>
        <view class="place-category">{{item.category}}</view>
        <view class="place-summary">{{item.summary}}</view>
        <view class="place-more">查看现场照片与通行建议 <text>›</text></view>
      </view>
    </view>
  </view>

  <view class="evidence-note"><view class="evidence-title">信息从哪里来？</view><view class="evidence-copy">所有地点均由团队实地拍摄并记录。绿色表示可通过，橙色表示可能需要协助，灰色表示仍有信息待确认。</view></view>
  <view class="secondary-actions">
    <view class="secondary-action" bindtap="reportIncident"><view class="secondary-icon warn">!</view><view><view class="secondary-title">发现临时障碍</view><view class="secondary-desc">上报施工、占用或停运</view></view></view>
    <view class="secondary-action" bindtap="goQuickCheck"><view class="secondary-icon scan">AI</view><view><view class="secondary-title">现场快速识别</view><view class="secondary-desc">不确定时再拍一张判断</view></view></view>
  </view>

  <view class="guide-mask" wx:if="{{showGuide}}"><view class="guide-card">
    <view class="guide-title">先看看这里能做什么</view>
    <view class="guide-step"><text>1</text><view><view class="guide-step-title">查看实地调研地点</view><view class="guide-step-copy">照片、设施情况和通行建议都来自现场记录。</view></view></view>
    <view class="guide-step"><text>2</text><view><view class="guide-step-title">遇到新地点就拍照</view><view class="guide-step-copy">AI 帮你识别台阶、坡道、电梯和潜在障碍。</view></view></view>
    <button class="guide-primary" bindtap="dismissGuide">开始使用</button>
  </view></view>
</view>
