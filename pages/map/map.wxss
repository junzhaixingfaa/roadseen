.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #f5f6f8;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #ffffff;
}
.searchbox {
  flex: 1;
  background: #f0f2f5;
  border-radius: 30rpx;
  padding: 14rpx 26rpx;
  color: #909399;
  font-size: 26rpx;
}
.filter-btn {
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #2f6fb0;
  background: #eaf1f9;
}
.filter-btn.on { background: #2f6fb0; color: #ffffff; }

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 14rpx 20rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}
.chip {
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #606266;
  background: #f0f2f5;
}
.chip.on { background: #2f6fb0; color: #ffffff; }

.map { width: 100%; }

.legend {
  position: absolute;
  top: 120rpx;
  right: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}
.lg { display: flex; align-items: center; font-size: 22rpx; color: #606266; margin: 4rpx 0; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 10rpx; }

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  z-index: 10;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  z-index: 11;
}
.s-name { font-size: 34rpx; font-weight: 600; }
.s-sum { margin: 12rpx 0 6rpx; }
.s-tip { margin-bottom: 12rpx; }
.s-btns { display: flex; gap: 20rpx; margin-top: 16rpx; }
.half { flex: 1; }
.sheet .btn-block { margin-top: 16rpx; }
