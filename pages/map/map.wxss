.map-page { min-height:100vh; padding:32rpx 28rpx 100rpx; background:#F7F4EE; color:#17243A; }
.page-head,.section-head,.place-topline,.map-toolbar { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.page-head { margin-bottom:28rpx; }.page-title { font-size:42rpx; font-weight:800; }.page-sub,.section-desc { margin-top:8rpx; color:#727887; font-size:22rpx; }
.report-link { flex-shrink:0; padding:12rpx 16rpx; color:#B7432C; background:#FCE5DD; border-radius:12rpx; font-size:23rpx; }
.ai-hero { position:relative; display:flex; gap:22rpx; padding:32rpx; background:#1D3557; color:#fff; border-radius:20rpx; overflow:hidden; }
.ai-mark { flex:none; width:58rpx; height:58rpx; line-height:58rpx; text-align:center; border-radius:14rpx; background:#F6DAD0; color:#1D3557; font-weight:800; }
.ai-copy { flex:1; min-width:0; }.ai-title { font-size:33rpx; font-weight:750; }.ai-desc { margin-top:14rpx; color:#D4DCE8; font-size:24rpx; line-height:1.65; }.ai-action { display:inline-block; margin-top:26rpx; padding:15rpx 24rpx; background:#F16B4F; border-radius:10rpx; font-size:25rpx; font-weight:700; }.ai-action text { margin-left:12rpx; }.camera-shape { display:none; }
.section-head { margin:36rpx 0 20rpx; }.section-title-main { font-size:31rpx; font-weight:750; }.filter-link { color:#1D3557; font-size:24rpx; }.filters { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:18rpx; }.chip { padding:12rpx 18rpx; background:#EDE8DF; border-radius:10rpx; font-size:23rpx; }.chip.on { background:#1D3557; color:#fff; }
.map { width:100%; height:410rpx; }.map-toolbar { margin:14rpx 0; }.map-button { flex:1; padding:18rpx; text-align:center; background:#E6EBF2; color:#1D3557; border-radius:10rpx; }.map-button.primary { background:#1D3557; color:#fff; }
.map-pending { display:flex; align-items:center; gap:16rpx; padding:32rpx 22rpx; border:1rpx solid #E3DDD3; border-radius:12rpx; background:#FFFFFF; }.pending-icon { font-size:36rpx; color:#1D3557; }.pending-title { font-size:24rpx; font-weight:650; }.pending-desc { color:#727887; font-size:21rpx; margin-top:4rpx; }.pending-retry { display:inline-block; margin-top:14rpx; color:#B7432C; font-size:22rpx; font-weight:650; }
.place-list { margin-top:8rpx; }.place-row { display:flex; gap:20rpx; padding:26rpx 0; border-bottom:1rpx solid #E3DDD3; }.place-thumb { flex:none; width:136rpx; height:164rpx; border-radius:12rpx; background:#E5DFD5; }.place-copy { flex:1; min-width:0; }.place-topline { flex-wrap:wrap; gap:7rpx; }.place-name { font-size:28rpx; font-weight:750; }.place-category { color:#727887; font-size:21rpx; margin-top:5rpx; }.place-summary { margin-top:10rpx; font-size:24rpx; color:#4D596B; line-height:1.55; }.place-more { margin-top:12rpx; font-size:22rpx; color:#A83E2A; }.place-more text { margin-left:6rpx; }
.evidence-note { margin-top:26rpx; padding:22rpx; background:#EEE9E0; border-radius:12rpx; }.evidence-title { font-size:24rpx; font-weight:700; }.evidence-copy { margin-top:8rpx; font-size:22rpx; line-height:1.65; color:#636978; }.secondary-actions { margin-top:20rpx; }.secondary-action { display:flex; align-items:center; gap:18rpx; padding:22rpx 0; border-bottom:1rpx solid #E3DDD3; }.secondary-icon { width:50rpx; height:50rpx; line-height:50rpx; text-align:center; border-radius:10rpx; color:#fff; background:#1D3557; font-size:22rpx; font-weight:700; }.secondary-icon.warn { background:#BB4B35; }.secondary-title { font-size:25rpx; font-weight:650; }.secondary-desc { font-size:22rpx; color:#727887; margin-top:4rpx; }
.guide-mask { position:fixed; z-index:99; left:0; right:0; top:0; bottom:0; display:flex; align-items:flex-end; padding:28rpx; background:rgba(19,35,61,.6); }.guide-card { width:100%; padding:32rpx; border-radius:24rpx; background:#F7F4EE; }.guide-title { font-size:34rpx; font-weight:750; }.guide-step { display:flex; gap:18rpx; margin-top:24rpx; }.guide-step>text { color:#B7432C; font-weight:750; }.guide-step-title { font-size:27rpx; font-weight:650; }.guide-step-copy { margin-top:6rpx; font-size:24rpx; color:#727887; }.guide-primary { margin-top:30rpx; background:#1D3557; color:#fff; border-radius:12rpx; }
.survey-map { position:relative; height:440rpx; overflow:hidden; border-radius:18rpx; background:#E5EDE5; border:1rpx solid #CCD8CC; }
.map-caption { position:absolute; top:14rpx; left:18rpx; color:#56675C; font-size:20rpx; z-index:2; }
.map-bottom { top:auto; bottom:14rpx; }
.road-horizontal { position:absolute; top:125rpx; width:100%; height:65rpx; background:#fff; text-align:center; color:#788281; font-size:21rpx; line-height:65rpx; }
.road-vertical { position:absolute; left:49%; top:0; width:62rpx; height:100%; background:#fff; color:#788281; font-size:20rpx; writing-mode:vertical-rl; text-align:center; padding:210rpx 16rpx 0; }
.survey-pin { position:absolute; z-index:3; padding:12rpx 14rpx; background:#fff; border-radius:12rpx; box-shadow:0 4rpx 12rpx #00000015; font-size:22rpx; color:#1D3557; font-weight:600; }
.survey-pin text { color:#187B80; margin-right:8rpx; }
.pin-xinghuo { left:5%; top:250rpx; }.pin-metro { left:34%; top:72rpx; }.pin-rtmart { right:3%; top:300rpx; }
