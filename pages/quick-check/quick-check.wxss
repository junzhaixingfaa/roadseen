.page { min-height: 100vh; padding: 20rpx 20rpx 180rpx; background: #F7F4EE; box-sizing: border-box; }
.intro { padding: 32rpx 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(145deg, #13233D 0%, #1D3557 100%); box-shadow: 0 14rpx 34rpx rgba(16,63,74,.16); }
.eyebrow { color: #F8C9B9; font-size: 18rpx; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.copy { margin-top: 12rpx; color: #D4DCE8; font-size: 24rpx; line-height: 1.65; }
.demo-tag { display: inline-block; margin-top: 20rpx; padding: 8rpx 14rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 12rpx; color: #FFE1A8; background: rgba(8,38,44,.34); font-size: 20rpx; }
.flow-card, .result-card, .safe-note { margin-top: 16rpx; padding: 26rpx; border: 1rpx solid #E7E2DA; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(24,58,64,.05); }
.step-head { display: flex; align-items: center; gap: 14rpx; color: #17243A; font-size: 29rpx; font-weight: 700; }
.step-no { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 50%; color: #fff; background: #1D3557; font-size: 22rpx; }
.photo-empty { display: flex; flex-direction: column; align-items: center; margin-top: 22rpx; padding: 54rpx 20rpx; border: 2rpx dashed #ADBBD0; border-radius: 20rpx; background: #F4F0E8; }
.camera { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 24rpx; color: #fff; background: #1D3557; font-size: 44rpx; }
.photo-title { margin-top: 18rpx; color: #1D3557; font-size: 28rpx; font-weight: 700; }
.photo-hint { margin-top: 8rpx; color: #74858B; font-size: 22rpx; }
.photo-wrap { overflow: hidden; margin-top: 22rpx; border-radius: 20rpx; background: #E9EEEE; }
.photo { display: block; width: 100%; height: 390rpx; }
.photo-actions { display: flex; justify-content: space-around; padding: 20rpx; color: #1D3557; background: #fff; font-size: 25rpx; }
.location-row { display: flex; align-items: center; margin-top: 20rpx; padding: 18rpx; border-radius: 18rpx; background: #F4F0E8; }
.location-icon { margin-right: 14rpx; color: #1D3557; font-size: 36rpx; }
.location-copy { display: flex; flex: 1; flex-direction: column; }
.location-title { color: #17243A; font-size: 25rpx; font-weight: 600; }
.location-hint { margin-top: 4rpx; color: #87959A; font-size: 20rpx; }
.arrow { color: #8A989D; font-size: 40rpx; }
.analyze-btn { margin-top: 22rpx; padding: 23rpx; border-radius: 12rpx; color: #fff; background: #C74B32; text-align: center; font-size: 28rpx; font-weight: 700; }
.analyze-btn.disabled { opacity: .55; }
.loading { margin-top: 20rpx; color: #718187; text-align: center; font-size: 22rpx; }
.loading-line { height: 6rpx; margin-bottom: 16rpx; border-radius: 6rpx; background: linear-gradient(90deg, #DDEBE9, #1D3557, #DDEBE9); }
.result-card { border-top: 8rpx solid #D88921; }
.result-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.result-kicker { color: #8B6A35; font-size: 20rpx; }
.result-title { margin-top: 4rpx; color: #7C4D0C; font-size: 36rpx; font-weight: 700; }
.confidence { padding: 7rpx 12rpx; border-radius: 12rpx; color: #7F652F; background: #FFF3D9; font-size: 19rpx; }
.summary { margin-top: 18rpx; color: #34474D; font-size: 25rpx; line-height: 1.65; }
.result-section { margin-top: 22rpx; padding: 20rpx; border-radius: 18rpx; background: #F4F0E8; }
.result-section.warning { background: #FFF6E8; }
.section-title { margin-bottom: 10rpx; color: #17243A; font-size: 25rpx; font-weight: 700; }
.bullet { display: flex; gap: 12rpx; margin-top: 9rpx; color: #53666D; font-size: 23rpx; line-height: 1.5; }
.bullet text { color: #1D3557; font-weight: 800; }
.warning .bullet text { color: #C87916; }
.disclaimer { margin-top: 20rpx; padding: 16rpx; border-radius: 14rpx; color: #755A2B; background: #FFF8E9; font-size: 21rpx; line-height: 1.55; }
.result-actions, .err-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.result-actions view, .err-actions view { flex: 1; padding: 20rpx 10rpx; border-radius: 16rpx; text-align: center; font-size: 24rpx; font-weight: 600; }
.err-title { font-size: 28rpx; font-weight: 600; color: #C84B4B; }
.err-desc { margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; color: #617078; }
.secondary { color: #1D3557; border: 1rpx solid #ADBBD0; background: #fff; }
.primary { color: #fff; background: #1D3557; }
.safe-note { color: #697A80; font-size: 22rpx; line-height: 1.6; }
.safe-title { margin-bottom: 8rpx; color: #31454B; font-size: 25rpx; font-weight: 700; }
