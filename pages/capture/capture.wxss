.capture { min-height: 100vh; background: #f5f6f8; padding-bottom: 20rpx; }

.cap-hd { background: #ffffff; padding: 24rpx; }
.cap-title { font-size: 32rpx; font-weight: 600; }
.prog { margin-top: 8rpx; font-size: 24rpx; color: #2f6fb0; }

.step-card { background: #ffffff; border-radius: 14rpx; margin: 16rpx 20rpx; padding: 22rpx; }
.st-title { font-size: 28rpx; font-weight: 600; }
.req { font-size: 20rpx; color: #D93026; background: #fdeceb; padding: 2rpx 12rpx; border-radius: 10rpx; }
.st-hint { font-size: 24rpx; color: #909399; margin: 6rpx 0 14rpx; }

.shot {
  height: 200rpx; border: 2rpx dashed #c8ccd4; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: #909399;
}
.plus { font-size: 60rpx; line-height: 1; }
.shot-t { font-size: 24rpx; margin-top: 8rpx; }

.shot-wrap { position: relative; }
.shot-img { width: 100%; height: 240rpx; border-radius: 12rpx; background: #ebeef5; display: block; }
.retake {
  position: absolute; right: 16rpx; bottom: 16rpx;
  background: rgba(0, 0, 0, 0.55); color: #ffffff; font-size: 22rpx;
  padding: 8rpx 20rpx; border-radius: 24rpx;
}

.cap-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #ffffff; border-top: 1rpx solid #eee; padding: 16rpx 24rpx;
}
.cap-bar .btn-block { margin: 0; }
