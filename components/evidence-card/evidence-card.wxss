.ec {
  width: 240rpx;
  flex-shrink: 0;
  background: #f7f8fa;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.ec-img { width: 240rpx; height: 180rpx; background: #ebeef5; display: block; }
.ec-type { font-size: 24rpx; font-weight: 600; padding: 8rpx 12rpx 0; }
.ec-tags { font-size: 22rpx; color: #2f6fb0; padding: 2rpx 12rpx; }
.ec-meta { font-size: 20rpx; color: #909399; padding: 2rpx 12rpx 10rpx; }
